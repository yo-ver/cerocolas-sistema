# --- base de datos ---------------------------------------------------------
# Desarrollo local sin PostgreSQL:
# DATABASE_URL=sqlite+pysqlite:///./cerocolas.db
DATABASE_URL=postgresql+psycopg://cerocolas:cambiar@db:5432/cerocolas

# --- seguridad -------------------------------------------------------------
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=cambiar-en-produccion
JWT_MINUTOS_EXPIRACION=720

# --- dominio ---------------------------------------------------------------
ZONA_HORARIA=America/Lima
HORA_CORTE_OPERATIVA=3
ESPERA_MAXIMA_MIN=480

# --- operacion -------------------------------------------------------------
ENTORNO=desarrollo
CORS_ORIGENES=http://localhost:5173
